#!/bin/bash
# Mock pi runtime for testing
set -euo pipefail

# Feature detection: answer --help instantly, before recording an invocation.
if [ "${1:-}" = "--help" ]; then
  echo "pi - mock"
  echo "  --continue, -c   Continue previous session"
  echo "  --model <id>     Model"
  [ "${MOCK_PI_HAS_APPROVE:-1}" = 1 ] && echo "  --approve, -a    Trust project-local files for this run"
  exit 0
fi

: "${MOCK_OUT_DIR:?MOCK_OUT_DIR not set}"
mkdir -p "$MOCK_OUT_DIR"

# Record invocation details
printf '%s\n' "$@" > "$MOCK_OUT_DIR/pi.args"
pwd > "$MOCK_OUT_DIR/pi.cwd"
echo $$ > "$MOCK_OUT_DIR/pi.pid"

# TERM trap to record kill signal
trap 'echo "KILLED" > "$MOCK_OUT_DIR/pi.status"; exit 143' TERM

# Heartbeat loop
MOCK_DURATION="${MOCK_DURATION:-2}"
MOCK_HANG="${MOCK_HANG:-0}"
START_TIME=$(date +%s)

while true; do
  date +%s > "$MOCK_OUT_DIR/pi.heartbeat"
  sleep 0.2 || true   # a TERM aimed at this child must not trip errexit before the TERM trap runs

  if [ "$MOCK_HANG" = "1" ]; then
    continue
  fi

  CURRENT_TIME=$(date +%s)
  ELAPSED=$((CURRENT_TIME - START_TIME))

  if [ "$ELAPSED" -ge "$MOCK_DURATION" ]; then
    break
  fi
done

# Normal completion
echo "DONE" > "$MOCK_OUT_DIR/pi.status"
echo "Mock pi completed successfully"
