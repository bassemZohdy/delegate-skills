#!/bin/bash
# Mock mimo runtime for testing
set -euo pipefail

: "${MOCK_OUT_DIR:?MOCK_OUT_DIR not set}"
mkdir -p "$MOCK_OUT_DIR"

# Special case: --help invocation (for feature detection)
if [ "$1" = "run" ] && [ "$2" = "--help" ]; then
  cat <<'EOF'
mimo run — Execute tasks with mimo

Options:
--dir <path>             Working directory
--dangerously-skip-permissions   Skip prompts
EOF
  if [ "${MOCK_MIMO_HAS_FILE:-0}" = "1" ]; then
    echo "--file <path>             Attach a file"
  fi
  exit 0
fi

# Record invocation details
printf '%s\n' "$@" > "$MOCK_OUT_DIR/mimo.args"
pwd > "$MOCK_OUT_DIR/mimo.cwd"
echo $$ > "$MOCK_OUT_DIR/mimo.pid"

# TERM trap to record kill signal
trap 'echo "KILLED" > "$MOCK_OUT_DIR/mimo.status"; exit 143' TERM

# Heartbeat loop
MOCK_DURATION="${MOCK_DURATION:-2}"
MOCK_HANG="${MOCK_HANG:-0}"
START_TIME=$(date +%s)

while true; do
  date +%s > "$MOCK_OUT_DIR/mimo.heartbeat"
  sleep 0.2

  if [ "$MOCK_HANG" = "1" ]; then
    continue
  fi

  CURRENT_TIME=$(date +%s)
  ELAPSED=$((CURRENT_TIME - START_TIME))

  if [ "$ELAPSED" -ge "$MOCK_DURATION" ]; then
    break
  fi
done

# Normal completion
echo "DONE" > "$MOCK_OUT_DIR/mimo.status"
echo "Mock mimo completed successfully"
