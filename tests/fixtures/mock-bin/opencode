#!/bin/bash
# Mock opencode runtime for testing
set -euo pipefail

# Special case: --help invocation (for feature detection). Checked before the
# MOCK_OUT_DIR requirement below — real --help doesn't need any env setup, and
# tests that never set MOCK_OUT_DIR (e.g. not-a-git-repo, worktree-reuse) would
# otherwise fail as soon as delegate.sh's flag-detection calls `opencode run
# --help`. Must also return before the heartbeat loop further down: real CLIs
# answer --help instantly, and delegate.sh calls this via command substitution
# with no timeout, so falling through to the loop would hang forever under
# MOCK_HANG=1.
if [ "$1" = "run" ] && [ "$2" = "--help" ]; then
  cat <<'EOF'
opencode run — Execute tasks with opencode

Options:
--dir <path>     Working directory
--file <path>    Attach a file
--auto           Auto-approve permissions that are not explicitly denied (dangerous!)
EOF
  exit 0
fi

: "${MOCK_OUT_DIR:?MOCK_OUT_DIR not set}"
mkdir -p "$MOCK_OUT_DIR"

# Record invocation details
printf '%s\n' "$@" > "$MOCK_OUT_DIR/opencode.args"
pwd > "$MOCK_OUT_DIR/opencode.cwd"
echo $$ > "$MOCK_OUT_DIR/opencode.pid"

# TERM trap to record kill signal
trap 'echo "KILLED" > "$MOCK_OUT_DIR/opencode.status"; exit 143' TERM

# Heartbeat loop
MOCK_DURATION="${MOCK_DURATION:-2}"
MOCK_HANG="${MOCK_HANG:-0}"
START_TIME=$(date +%s)

while true; do
  date +%s > "$MOCK_OUT_DIR/opencode.heartbeat"
  sleep 0.2

  if [ "$MOCK_HANG" = "1" ]; then
    continue
  fi

  CURRENT_TIME=$(date +%s)
  ELAPSED=$((CURRENT_TIME - START_TIME))

  if [ "$ELAPSED" -ge "$MOCK_DURATION" ]; then
    break
  fi
done

# Normal completion
echo "DONE" > "$MOCK_OUT_DIR/opencode.status"
echo "Mock opencode completed successfully"
